{
  "version": "1.1.0",
  "description": "Skill Route Registration — map skills ไปยัง Central Bus endpoints",
  "notes": [
    "target_agent = agent_id จริงที่ลงทะเบียนใน workers/agent_worker_service.py",
    "  (target_department เป็นชื่อแผนก ไม่ใช่ agent_id → ไม่มี consumer รับ)",
    "skill_prompt = พาธไป SKILL.md ที่จะใส่เป็น description ให้ agent ทำตาม"
  ],
  "routes": [
    {
      "skill": "@solocorp/cross-dept/pipeline-bridge",
      "method": "POST",
      "path": "/v1/skills/cross-dept/pipeline-bridge",
      "target_department": "architect",
      "target_agent": "architect-songsak",
      "skill_prompt": "skills/@solocorp/cross-dept/pipeline-bridge/SKILL.md",
      "queue_topic": "skill.invoke",
      "mirror_check": true,
      "min_mirror_level": "L3",
      "status": "registered"
    },
    {
      "skill": "@solocorp/cross-dept/mirror-check",
      "method": "POST",
      "path": "/v1/skills/cross-dept/mirror-check",
      "target_department": "ceo",
      "target_agent": "orchestrator-wut",
      "queue_topic": "governance.mirror",
      "mirror_check": false,
      "min_mirror_level": "L2",
      "status": "registered"
    },
    {
      "skill": "@solocorp/cfo/finance-tools",
      "method": "POST",
      "path": "/v1/skills/cfo/finance-tools",
      "target_department": "cfo",
      "target_agent": "cfo-meetoo",
      "queue_topic": "skill.cfo.invoke",
      "mirror_check": true,
      "min_mirror_level": "L3",
      "required_fields": ["command", "department"],
      "status": "registered"
    },
    {
      "skill": "@solocorp/coo/daily-ops",
      "method": "POST",
      "path": "/v1/skills/coo/daily-ops",
      "target_department": "coo",
      "target_agent": "orchestrator-wut",
      "skill_prompt": "skills/@solocorp/coo/daily-ops/SKILL.md",
      "queue_topic": "skill.coo.invoke",
      "mirror_check": false,
      "min_mirror_level": "L2",
      "required_fields": ["action"],
      "description": "COO daily operations — generate ops report, route requests, check SOP compliance",
      "status": "registered"
    },
    {
      "skill": "@solocorp/ceo/sprint-plan",
