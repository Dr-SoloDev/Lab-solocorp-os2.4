# SoloCorp OS — Environment Variables
# copy ไปเป็น .env:  cp .env.example .env
# ⚠️ repo นี้เป็น public — ห้าม commit .env เด็ดขาด (.env ถูก gitignore แล้ว)
# ค่าในไฟล์นี้เป็น dummy สำหรับ local-dev เท่านั้น

SOLOCORP_API_KEY=sk-solocorp-admin-local-dev-001
SOLOCORP_BUS_URL=http://127.0.0.1:8099

# [DISCONNECTED 2026-11-12] Maxplus AI — removed, use opencode provider (opencode/deepseek-v4.1-flash-free)
MAXPLUS_API_KEY=your-maxplus-api-key-here # [DISCONNECTED] use opencode provider
MAXPLUS_BASE_URL=https://api.maxplus-ai.cc/v1
MAXPLUS_MODEL=claude-sonnet-4-6

# OpenRouter — FLUX.3 Image Klein (legacy image path, provider="openrouter")
OPENROUTER_API_KEY=your-openrouter-key-here

# NVIDIA NIM — FLUX.3 Image Klein (default image path, provider="nvidia")
NVIDIA_API_KEY=your-nvidia-key-here
