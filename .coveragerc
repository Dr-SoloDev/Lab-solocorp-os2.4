[run]
source = .
omit =
    .venv/*
    .git/*
    __pycache__/*
    tests/*
    */__pycache__/*
    dist/*
    .grok/*
    .opencode/*
    .codegraph/*
    node_modules/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if __name__ == .__main__.:
    raise NotImplementedError
    raise AssertionError
    if typing.TYPE_CHECKING:

fail_under = 0
