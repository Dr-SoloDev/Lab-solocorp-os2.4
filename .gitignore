# OS
.DS_Store
Thumbs.db

# Hermes runtime (private repo — .env.example is tracked)
.env
.env.local
.env.production
.env.save
.env.*.save
.env.*.bak
.env.*.old

# SkillHub reference (cloned repo, not part of SoloCorp OS)
/reference/skillhub/

# Antigravity Awesome Skills (cloned community skill library)
/reference/antigravity-awesome-skills/

# Central Bus SQLite temp files
central_bus/bus.db-shm
central_bus/bus.db-wal

# Campaign artifacts are regenerable by the Concat workflow — not source code.
# Per Decision Gate Q1: "สร้างใหม่ได้ไหม?" → yes → not tracked in git.
central_bus/content/campaign-*-manifest_*.json
central_bus/content/campaign-*-publish-gate-*.md
central_bus/content/*-approval-*.json

# Module registry runtime state (config lives in config/module-registry.json).
# Atomic writes go through tempfile.NamedTemporaryFile(prefix=".<name>.", suffix=".tmp"),
# i.e. .module-registry.state.json.<random>.tmp — match that exact shape so a
# SIGKILL mid-write cannot leave untracked temp files behind in config/ or
# central_bus/.
central_bus/module-registry.state.json
central_bus/.module-registry.state.json.*.tmp
config/.module-registry.json.*.tmp

# Registry rollback snapshot — written next to the tracked config before every
# config write (see docs/runbooks/registry-schema-rollback.md). Never source.
*.bak*

# SoloCorp App provider credential. config/provider.json is tracked — it holds
# only the provider choice and the credential *slot name*, never the secret.
# Anything written by an atomic save uses ".<name>.<random>.tmp" beside it.
config/provider.credentials.json
**/provider.credentials.json
config/.provider.json.*.tmp
config/.provider.credentials.json.*.tmp

# Generated voiceovers are local runtime artifacts
central_bus/content/voiceover-*

# Render output is a build artifact, regenerable by
# render_campaign_media_local / render_campaign_with_concat.
# Files stay on disk for review; they are not source and never go into git.
# See docs/runbooks/CONTENT-LOCAL-MEDIA-RENDER.md
central_bus/content/local_media/
central_bus/content/generated-image-*
central_bus/content/concat_renders/

# Agency Agents (cloned agent personality library)
/reference/agency-agents/

# Awesome AI Dev Agents (curated list of AI software dev agents)
/reference/awesome-ai-dev-agents/

